{
  "openapi": "3.0.1",
  "info": {
    "title": "Vodostaji BiH",
    "description": "Stanje rijeka u BiH, objedinjeno iz javnih izvora više agencija. Podaci nisu zvanični i ne služe za odbranu od poplava.",
    "version": "v1"
  },
  "paths": {
    "/api/v1/geojson/reaches": {
      "get": {
        "tags": [
          "Vodostaji.Api"
        ],
        "operationId": "GetReaches",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/geo+json": {
                "schema": {
                  "$ref": "#/components/schemas/ReachFeatureCollection"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/geojson/points/{sourceId}": {
      "get": {
        "tags": [
          "Vodostaji.Api"
        ],
        "operationId": "GetPointSource",
        "parameters": [
          {
            "name": "sourceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/geo+json": {
                "schema": {
                  "$ref": "#/components/schemas/ReachFeatureCollection"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/geojson/stations": {
      "get": {
        "tags": [
          "Vodostaji.Api"
        ],
        "operationId": "GetStations",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/geo+json": {
                "schema": {
                  "$ref": "#/components/schemas/StationFeatureCollection"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/reaches/{sourceId}/{stationKey}/history": {
      "get": {
        "tags": [
          "Vodostaji.Api"
        ],
        "operationId": "GetReachHistory",
        "parameters": [
          {
            "name": "sourceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "stationKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "days",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReachHistory"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sources": {
      "get": {
        "tags": [
          "Vodostaji.Api"
        ],
        "operationId": "GetSources",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SourceStatus"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Vodostaji.Api"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CircuitState": {
        "enum": [
          0,
          1,
          2
        ],
        "type": "integer",
        "format": "int32"
      },
      "HistoryPoint": {
        "type": "object",
        "properties": {
          "measuredAt": {
            "type": "string",
            "format": "date-time"
          },
          "valueCm": {
            "type": "number",
            "format": "double"
          },
          "level": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ReachFeature": {
        "required": [
          "geometry",
          "properties"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true,
            "readOnly": true
          },
          "geometry": {
            "nullable": true
          },
          "properties": {
            "$ref": "#/components/schemas/ReachProperties"
          }
        },
        "additionalProperties": false
      },
      "ReachFeatureCollection": {
        "required": [
          "features",
          "meta"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true,
            "readOnly": true
          },
          "meta": {
            "$ref": "#/components/schemas/ReachMeta"
          },
          "features": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReachFeature"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ReachHistory": {
        "required": [
          "agencyName",
          "days",
          "name",
          "points",
          "sourceId",
          "stationKey"
        ],
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "nullable": true
          },
          "stationKey": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "river": {
            "type": "string",
            "nullable": true
          },
          "days": {
            "type": "integer",
            "format": "int32"
          },
          "points": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HistoryPoint"
            },
            "nullable": true
          },
          "thresholds": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReachThreshold"
            },
            "nullable": true
          },
          "thresholdsDefinedBy": {
            "type": "string",
            "nullable": true
          },
          "agencyName": {
            "type": "string",
            "nullable": true
          },
          "collectingSince": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ReachMeta": {
        "required": [
          "fetchedAt",
          "generatedAt",
          "knownCount",
          "measuredCount",
          "reachCount",
          "sourceId",
          "unknownCount",
          "withoutGeometry"
        ],
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "nullable": true
          },
          "fetchedAt": {
            "type": "string",
            "format": "date-time"
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "reachCount": {
            "type": "integer",
            "format": "int32"
          },
          "knownCount": {
            "type": "integer",
            "format": "int32"
          },
          "unknownCount": {
            "type": "integer",
            "format": "int32"
          },
          "measuredCount": {
            "type": "integer",
            "format": "int32"
          },
          "withoutGeometry": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "ReachProperties": {
        "required": [
          "agencyName",
          "agencyUrl",
          "color",
          "expectedIntervalMinutes",
          "fetchedAt",
          "intervalIsMeasured",
          "level",
          "levelLabel",
          "name",
          "publicationLagMinutes",
          "sourceId",
          "stationKey",
          "statusLabelOriginal"
        ],
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "nullable": true
          },
          "stationKey": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "river": {
            "type": "string",
            "nullable": true
          },
          "level": {
            "type": "string",
            "nullable": true
          },
          "levelLabel": {
            "type": "string",
            "nullable": true
          },
          "color": {
            "type": "string",
            "nullable": true
          },
          "statusLabelOriginal": {
            "type": "string",
            "nullable": true
          },
          "valueCm": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "gaugeZeroMetres": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "measuredAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "fetchedAt": {
            "type": "string",
            "format": "date-time"
          },
          "ageMinutes": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "expectedIntervalMinutes": {
            "type": "integer",
            "format": "int64"
          },
          "intervalIsMeasured": {
            "type": "boolean"
          },
          "publicationLagMinutes": {
            "type": "integer",
            "format": "int64"
          },
          "ageRatio": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "previousValueCm": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "previousMeasuredAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "changeCm": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "changeOverMinutes": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "publishedTrend": {
            "type": "string",
            "nullable": true
          },
          "publishedTrendLabel": {
            "type": "string",
            "nullable": true
          },
          "agencyName": {
            "type": "string",
            "nullable": true
          },
          "agencyUrl": {
            "type": "string",
            "nullable": true
          },
          "sourceUrl": {
            "type": "string",
            "nullable": true
          },
          "noDataReason": {
            "type": "string",
            "nullable": true
          },
          "thresholds": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReachThreshold"
            },
            "nullable": true
          },
          "thresholdsDefinedBy": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ReachThreshold": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "nullable": true
          },
          "valueCm": {
            "type": "number",
            "format": "double"
          },
          "level": {
            "type": "string",
            "nullable": true
          },
          "labelOriginal": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "SourceStatus": {
        "required": [
          "agencyName",
          "clockEvidence",
          "sourceId"
        ],
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "nullable": true
          },
          "agencyName": {
            "type": "string",
            "nullable": true
          },
          "lastAttemptAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "lastSuccessAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "consecutiveFailures": {
            "type": "integer",
            "format": "int32"
          },
          "circuit": {
            "$ref": "#/components/schemas/CircuitState"
          },
          "lastFailureReason": {
            "type": "string",
            "nullable": true
          },
          "knownCount": {
            "type": "integer",
            "format": "int32"
          },
          "unknownCount": {
            "type": "integer",
            "format": "int32"
          },
          "measuredCount": {
            "type": "integer",
            "format": "int32"
          },
          "withoutMeasurementCount": {
            "type": "integer",
            "format": "int32"
          },
          "clockEvidence": {
            "type": "string",
            "nullable": true
          },
          "isHealthy": {
            "type": "boolean",
            "readOnly": true
          }
        },
        "additionalProperties": false
      },
      "StationFeature": {
        "required": [
          "geometry",
          "properties"
        ],
        "type": "object",
        "properties": {
          "geometry": {
            "nullable": true
          },
          "properties": {
            "$ref": "#/components/schemas/StationProperties"
          }
        },
        "additionalProperties": false
      },
      "StationFeatureCollection": {
        "required": [
          "features",
          "meta"
        ],
        "type": "object",
        "properties": {
          "meta": {
            "$ref": "#/components/schemas/StationMeta"
          },
          "features": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StationFeature"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "StationMeta": {
        "required": [
          "fetchedAt",
          "sourceId",
          "stationCount",
          "withoutGaugeZero",
          "withoutGeometry",
          "withoutName"
        ],
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "nullable": true
          },
          "fetchedAt": {
            "type": "string",
            "format": "date-time"
          },
          "stationCount": {
            "type": "integer",
            "format": "int32"
          },
          "withoutGeometry": {
            "type": "integer",
            "format": "int32"
          },
          "withoutGaugeZero": {
            "type": "integer",
            "format": "int32"
          },
          "withoutName": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "StationProperties": {
        "required": [
          "agencyName",
          "agencyUrl",
          "name",
          "sourceId"
        ],
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "nullable": true
          },
          "stationKey": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "location": {
            "type": "string",
            "nullable": true
          },
          "stationType": {
            "type": "string",
            "nullable": true
          },
          "gaugeZero": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "gaugeBoardCount": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "agencyName": {
            "type": "string",
            "nullable": true
          },
          "agencyUrl": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}